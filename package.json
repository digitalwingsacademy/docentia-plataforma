{
  "name": "docentia-plataforma",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de formacion digital para docentes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalwingsacademy/docentia-plataforma.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "setup": "tsx scripts/setup.ts",
    "db:types": "supabase gen types typescript --linked > lib/database.types.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "content:sync": "tsx --env-file=.env.local scripts/sync-course.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mux/mux-node": "^15.1.0",
    "@mux/mux-player-react": "^3.13.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "^16.3.4",
    "next-mdx-remote": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
