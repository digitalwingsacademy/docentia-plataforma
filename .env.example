# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key server-side. NUNCA la expongas al cliente ni la commitees.
SUPABASE_SECRET_KEY=

# Contenido: "local" para desarrollo (lee de CONTENT_PATH), "github" en despliegues.
CONTENT_SOURCE=local
CONTENT_PATH=../docentia-contenidos
CONTENT_GITHUB_OWNER=digitalwingsacademy
CONTENT_GITHUB_REPO=docentia-contenidos
# Debe coincidir con el secreto configurado en el webhook de GitHub.
CONTENT_WEBHOOK_SECRET=

# Mux → Settings → Access Tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux → Settings → Signing Keys (la private key solo se muestra una vez)
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
# Opcional: Mux Data (analitica de visionado) → Settings → Environments
NEXT_PUBLIC_MUX_DATA_ENV_KEY=

# Opcionales: si no existen, los botones de SSO correspondientes no se muestran (ADR-006)
GOOGLE_OAUTH_CLIENT_ID=
AZURE_OAUTH_CLIENT_ID=
